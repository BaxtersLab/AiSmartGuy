# GBNF grammar for AiSmartGuy Phase 2 structured findings.
# Constrains a model's per-chapter output to a JSON array of findings that the
# mechanical merge (orchestrator::findings) parses losslessly. Each object:
#   {"rule_id","quote","location","severity","note"}
# severity is one of low|medium|high. An empty array [] means "nothing found".
# Used with llama.cpp: --grammar-file assets/grammars/findings.gbnf

root     ::= ws "[" ws ( finding ( ws "," ws finding )* )? ws "]" ws

finding  ::= "{" ws (
              "\"rule_id\""  ws ":" ws string ws "," ws
              "\"quote\""    ws ":" ws string ws "," ws
              "\"location\"" ws ":" ws string ws "," ws
              "\"severity\"" ws ":" ws severity ws "," ws
              "\"note\""     ws ":" ws string ws
            ) "}"

severity ::= "\"low\"" | "\"medium\"" | "\"high\""

string   ::= "\"" char* "\""
char     ::= [^"\\] | "\\" ( ["\\/bfnrt] | "u" hex hex hex hex )
hex      ::= [0-9a-fA-F]

# Bounded, as in llama.cpp's own json.gbnf: an unbounded ws let a model spend
# its whole token budget on blank lines (1,949 characters of them in one real
# Hermes-7B pass, 2026-09-28), and the pass was cut off.
ws       ::= [ \t\n\r]{0,20}
